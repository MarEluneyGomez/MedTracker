# Variables de entorno del backend. Copiar los valores a la terminal (o al IDE) antes de
# ./mvnw spring-boot:run: Spring las lee del entorno, no de este archivo. Sin secretos reales.

# Obligatorias
DATABASE_URL=jdbc:postgresql://host-de-neon/medtracker?sslmode=require
DATABASE_USER=usuario
DATABASE_PASSWORD=contraseña
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=

# Sesión (minutos)
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_MINUTES=2880

# Zona horaria que define "hoy" para generar las tomas
MEDTRACKER_TIMEZONE=America/Argentina/Buenos_Aires

# Omisión automática de tomas pendientes (RN-04)
MEDTRACKER_DOSE_AUTO_SKIP_ENABLED=true
MEDTRACKER_DOSE_AUTO_SKIP_INTERVAL=PT5M
MEDTRACKER_DOSE_SKIP_AFTER_MINUTES=120

# Push de recordatorios (RF-06). Apagado por defecto; provider log = simulado, fcm = Firebase
MEDTRACKER_PUSH_ENABLED=false
MEDTRACKER_PUSH_PROVIDER=log
MEDTRACKER_PUSH_INTERVAL=PT1M
MEDTRACKER_PUSH_DELAY_MINUTES=15
MEDTRACKER_PUSH_CATCH_UP_MINUTES=30
# UUID separados por coma para limitar el envío en pruebas; vacío = todos
MEDTRACKER_PUSH_ALLOWED_USER_IDS=
# Con provider=fcm, una de las dos: ruta al JSON de la cuenta de servicio (fuera del repo) o su contenido
GOOGLE_APPLICATION_CREDENTIALS=
MEDTRACKER_PUSH_FCM_CREDENTIALS_JSON=
MEDTRACKER_PUSH_FCM_CONNECT_TIMEOUT_MS=5000
MEDTRACKER_PUSH_FCM_READ_TIMEOUT_MS=10000

# Hilos de los jobs programados y espera al apagar
SPRING_TASK_SCHEDULING_POOL_SIZE=2
SPRING_TASK_SCHEDULING_SHUTDOWN_PERIOD=30s

# Solo para desarrollo
JPA_SHOW_SQL=false
MEDTRACKER_DEV_TOOLS_ENABLED=false
